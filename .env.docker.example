# Chép thành `.env` ở ngay thư mục này rồi sửa cho đúng máy bạn: `docker compose` tự đọc nó.
# Đường dẫn phải là đường dẫn TUYỆT ĐỐI trên máy host. Trên Windows dùng dấu `/`, không dùng `\`.

# --- Bắt buộc ngó qua ---------------------------------------------------------------------------

# Thư mục đăng nhập của Claude Code trên máy host.
#   Windows: C:/Users/<tên bạn>/.claude
#   macOS/Linux: /Users/<tên bạn>/.claude  ·  /home/<tên bạn>/.claude
CLAUDE_DIR=${HOME}/.claude

# Thư mục CHA chứa các repo mà bạn muốn Studio làm việc lên. Bên trong container nó là `/repos`,
# nên khi thêm project trong giao diện hãy nhập đường dẫn kiểu `/repos/<tên-repo>`.
#   ví dụ Windows: E:/gits
REPOS_DIR=${HOME}/repos

# --- Tuỳ chọn -----------------------------------------------------------------------------------

# Cổng mở ra máy host (trong container luôn là 4311).
STUDIO_PORT=4311

TZ=Asia/Ho_Chi_Minh

# Ghim phiên bản Claude Code CLI cho ảnh, ví dụ 2.0.14. Mặc định lấy bản mới nhất lúc build.
CLAUDE_CLI_VERSION=latest

# Bot Discord (không bắt buộc — xem agile-studio/BOT.md).
DISCORD_TOKEN=
DISCORD_CHANNEL=
