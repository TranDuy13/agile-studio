# Agile Studio — cấu hình môi trường.
# Copy file này thành `.env` rồi chỉnh. KHÔNG có .env thì app chạy y như mặc định.
# Đường dẫn trên Windows nên dùng "/" hoặc "\\" để tránh lỗi escape (vd D:/agile-out).

# ---- Đường dẫn (issue 03) ----
# Nơi lưu state của app (studio.json, accounts.json). Mặc định: ~/.agile-studio
# DATA_DIR=

# Workspace tài liệu managed theo project. Mặc định: <app>/projects
# PROJECTS_DIR=

# File đính kèm requirement. Mặc định: <app>/requirements
# REQUIREMENTS_DIR=

# Thư viện skill tổng (.skill/). Mặc định: <app>/.skill
# AGILE_SKILLS_DIR=

# ---- Cổng ----
# API server (Express + WS). Mặc định: 4311
# SERVER_PORT=4311
# Vite dev server (proxy /api,/ws sang SERVER_PORT). Mặc định: 5311
# WEB_PORT=5311

# ---- Claude CLI (issue 01) ----
# Config dir mặc định của Claude Code. Mặc định: ~/.claude
# CLAUDE_CONFIG_DIR=
# Đường dẫn Claude CLI nếu KHÔNG nằm trên PATH (vd bản kèm VSCode extension).
# Trỏ tới claude.exe / claude.cmd / claude. Để trống = tự dò (PATH + vị trí thường gặp).
# CLAUDE_BIN=

# ---- Storage ----
# Where app data is stored. Same data, different engine:
#   json     - single studio.json file (default, zero-config)
#   sqlite   - one .sqlite file (node:sqlite, built-in; no install)
#   postgres - one shared DB; use it to run the app across several machines
# Switching to sqlite/postgres imports an existing studio.json on first start.
# With sqlite/postgres the managed doc workspace (projects/<slug>) and requirement
# attachments are stored in the DB as well, and written to disk only as a working copy
# for the agents — so pointing several machines at one Postgres shares the files too.
# STORAGE_DRIVER=json
# SQLITE_PATH=               # .sqlite file path; default <DATA_DIR>/studio.sqlite
# DATABASE_URL=              # postgres connection string, e.g. postgres://user:pass@host:5432/agile

# ---- Discord bot (issue 08) ----
# DISCORD_TOKEN=
# DISCORD_CHANNEL=
# DISCORD_MENTION=
# DISCORD_PREFIX=!
# AGILE_API=http://localhost:4311
