# Agile Studio — cấu hình môi trường.
# Copy file này thành `.env` rồi chỉnh. KHÔNG có .env thì app chạy y như mặc định.
# Đường dẫn trên Windows nên dùng "/" hoặc "\\" để tránh lỗi escape (vd D:/agile-out).

# ---- Đường dẫn (issue 03) ----
# Nơi lưu state của app (studio.json, accounts.json). Mặc định: ~/.agile-studio
# DATA_DIR=

# Workspace tài liệu managed theo project. Mặc định: <app>/projects
# PROJECTS_DIR=

# File đính kèm requirement. Mặc định: <app>/requirements
# REQUIREMENTS_DIR=

# Thư viện skill tổng (.skill/). Mặc định: <app>/.skill
# AGILE_SKILLS_DIR=

# ---- Cổng ----
# API server (Express + WS). Mặc định: 4311
# SERVER_PORT=4311
# Vite dev server (proxy /api,/ws sang SERVER_PORT). Mặc định: 5311
# WEB_PORT=5311

# ---- Claude CLI (issue 01) ----
# Config dir mặc định của Claude Code. Mặc định: ~/.claude
# CLAUDE_CONFIG_DIR=
# Đường dẫn Claude CLI nếu KHÔNG nằm trên PATH (vd bản kèm VSCode extension).
# Trỏ tới claude.exe / claude.cmd / claude. Để trống = tự dò (PATH + vị trí thường gặp).
# CLAUDE_BIN=

# ---- Storage (issue 04 — dành sẵn, chưa dùng) ----
# STORAGE_DRIVER=json        # json | sqlite | postgres
# DATABASE_URL=              # dùng khi STORAGE_DRIVER=postgres
# SQLITE_PATH=               # dùng khi STORAGE_DRIVER=sqlite

# ---- Discord bot (issue 08) ----
# DISCORD_TOKEN=
# DISCORD_CHANNEL=
# DISCORD_MENTION=
# DISCORD_PREFIX=!
# AGILE_API=http://localhost:4311
